# Worker environment (local development template)
# Copy this file to BOTH apps/worker/.env (Prisma CLI) and
# apps/worker/.dev.vars (Wrangler dev), then fill in real values.
# Never commit real credentials.

# Neon PostgreSQL connection string. Use the pooled Neon URL with TLS.
# The same value is supplied as a Cloudflare Worker secret when deployed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Exact browser origin allowed by the Worker CORS policy (no wildcard).
ALLOWED_ORIGIN=http://localhost:3000
