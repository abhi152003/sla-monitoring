{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sla-monitoring-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://sla.abhip.xyz"
  }
}
